# Rahasia & konfigurasi lokal — JANGAN pernah di-commit / di-ZIP
.env
.env.*
!.env.example

# Dependensi & hasil build
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
composer.phar

# Upload & cache runtime
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/logs/*
!/storage/**/.gitignore
/bootstrap/cache/*.php

# Database lokal, test, editor, OS
/database/*.sqlite
/database/*.sqlite-journal
.phpunit.result.cache
.phpunit.cache
.idea/
.vscode/
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
auth.json
