<mxfile host="app.diagrams.net"><diagram id="d1" name="ERD Konseptual (Chen)"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c2" value="EVENTSYNC — ERD KONSEPTUAL (CHEN)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="0" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="Atribut oval | Entitas persegi | Relasi belah ketupat | Atribut PK bergaris bawah (kuning) | FK (oranye) | UNIQUE gabungan (putus-putus). USERS punya relasi organizer (makes) dan reviewer (reviews) ke EVENTS. EVENT_REGISTRATIONS = entitas asosiatif USERS–EVENTS (M:N). PERSONAL_ACCESS_TOKENS = tabel teknis Laravel Sanctum; hubungannya ke USERS bersifat POLIMORFIK (tokenable_type + tokenable_id, index morphs) sehingga digambar putus-putus dan TIDAK punya foreign key database. Aturan ON DELETE pada FK nyata: events.organizer_id &amp; events.category_id = RESTRICT; events.reviewed_by = SET NULL; speakers/schedules/event_committees/event_registrations.event_id = CASCADE; event_registrations.user_id = CASCADE; schedules.speaker_id = SET NULL. events memakai soft delete (deleted_at). status event: draft | pending_review | approved | rejected | cancelled; status pendaftaran: registered | cancelled | attended." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="42" width="2400" height="110" as="geometry"/></mxCell>
